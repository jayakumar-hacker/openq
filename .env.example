# OpenQ environment variables - PLACEHOLDERS ONLY.
# Copy to ".env" (git-ignored) and fill in your own values.
# Spring Boot does NOT load .env files by itself: export these in your shell first
# (commands are in README.md -> Quickstart).

# JDBC URL of your PostgreSQL database.
# Local:  jdbc:postgresql://localhost:5432/openq
# Azure:  jdbc:postgresql://<DB_HOST>.postgres.database.azure.com:5432/openq?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/openq

# Database user and password (never commit real values).
DB_USERNAME=openq
DB_PASSWORD=<your-database-password>

# Optional: timezone used to decide which slots are "in the future" (must match the zone in data.sql).
# OPENQ_CLINIC_ZONE=Asia/Kolkata

# Optional (only for the *IT integration tests): a separate throwaway database.
# TEST_DB_URL=jdbc:postgresql://localhost:5432/openq_test
# TEST_DB_USERNAME=openq
# TEST_DB_PASSWORD=<your-test-database-password>
